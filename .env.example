# Public URL of the web UI, used in login emails (required when SMTP is set)
WEB_BASE_URL=http://localhost:8080

# Shared secret between the web backend and relay, so the relay doesn't
# rate-limit all web users together as one address. Generate one with:
#   openssl rand -hex 32
RELAY_TRUSTED_TOKEN=

# Gmail SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

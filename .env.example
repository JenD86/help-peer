# Public URL of the web UI, used in login emails (required when SMTP is set)
WEB_BASE_URL=http://localhost:8080

# Where relay, storage and web data live on the host (default: ./data next to
# docker-compose.yml). On a server, point it outside the git checkout, e.g.
#   DATA_DIR=/home/help-peer/data
# DATA_DIR=./data

# RELAY_URL_PUBLIC=https://relay.example.com
# STORAGE_NODES_PUBLIC=https://node.example.com

# Storage node capacity in bytes (default 1GB). Example below is 15GB (15 x 1024^3).
# Shards live for 24h even after a successful receive, so size this for your traffic
# and keep it below the free disk space of the server.
# STORAGE_CAPACITY=16106127360

# Shared secret between the web backend and relay, so the relay doesn't
# rate-limit all web users together as one address. Generate one with:
#   openssl rand -hex 32
RELAY_TRUSTED_TOKEN=

# Gmail SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Lets you list, ban and reinstate volunteer storage nodes via
# /api/admin/nodes. Generate one with: openssl rand -hex 32
NODE_ADMIN_TOKEN=

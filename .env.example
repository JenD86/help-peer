# Public URL of the web UI, used in login emails (required when SMTP is set)
WEB_BASE_URL=http://localhost:8080

# Where relay, storage and web data live on the host (default: ./data next to
# docker-compose.yml). On a server, point it outside the git checkout, e.g.
#   DATA_DIR=/home/help-peer/data
# DATA_DIR=./data

# RELAY_URL_PUBLIC=https://relay.example.com
# STORAGE_NODES_PUBLIC=https://node.example.com

# Storage node capacity in bytes (default 1GB). Example below is 15GB (15 x 1024^3).
# Shards live for 24h even after a successful receive, so size this for your traffic
# and keep it below the free disk space of the server.
# STORAGE_CAPACITY=16106127360

# Shared secret between the web backend and relay, so the relay doesn't
# rate-limit all web users together as one address. Generate one with:
#   openssl rand -hex 32
RELAY_TRUSTED_TOKEN=

# Gmail SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com

# Lets you list, ban and reinstate volunteer storage nodes via
# /api/admin/nodes. Generate one with: openssl rand -hex 32
NODE_ADMIN_TOKEN=

# Limits on uploads made through the website. Anyone can upload, so before a
# transfer starts the page announces its size and the server decides: how big
# one transfer may be, how many a client may start per hour, and how much a
# client may send per 24 hours (reserved when the transfer starts). A client is
# an address as set by the proxy (WEB_TRUST_PROXY=1); an IPv6 /64 counts as one.
# Segments are also held in memory while they are stored, so only a few may be
# in flight at once.
# Defaults: 10 GiB per transfer, 2 transfers per hour, 20 GiB per client per
# 24 hours, 3 segments at once per client and 8 overall.
# Keep SEGMENT_DAILY_BYTES within what your storage nodes can hold (a file takes
# 1.5x its size on the nodes); raise these numbers when the nodes grow.
# The CLI and SDK talk to the storage nodes directly and are not covered.
# TRANSFER_MAX_BYTES=10737418240
# TRANSFERS_PER_HOUR=2
# SEGMENT_DAILY_BYTES=21474836480
# SEGMENT_CONCURRENCY=3
# SEGMENT_MAX_CONCURRENT=8
